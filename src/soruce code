import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import scipy.stats as stats

df = pd.read_csv("data/ai_adoption_dataset.csv")

print("\n--- DATA PREVIEW ---")
print(df.head())

print("\n--- DATA INFO ---")
print(df.info())


print("\nShape:", df.shape)

print("\nMissing Values:\n", df.isnull().sum())

print("\nDuplicate Records:", df.duplicated().sum())

print("\nStatistical Summary:\n", df.describe())



print("\nTotal Organizations:", len(df))

print("\nMost Used AI Tools:")
print(df['ai_tool'].value_counts())

print("\nIndustry Distribution:")
print(df['industry'].value_counts())

print("\nCompany Size Distribution:")
print(df['company_size'].value_counts())


plt.figure(figsize=(8,5))
sns.countplot(data=df, x='ai_tool')
plt.xticks(rotation=45)
plt.title("Most Commonly Used AI Tools")
plt.savefig("images/most_used_ai_tools.png")
plt.show()

plt.figure(figsize=(10,5))
sns.countplot(data=df, x='industry')
plt.xticks(rotation=45)
plt.title("AI Adoption by Industry")
plt.savefig("images/adoption_by_industry.png")
plt.show()

plt.figure(figsize=(8,5))
sns.countplot(data=df, x='company_size')
plt.title("Company Size Distribution")
plt.savefig("images/company_size_distribution.png")
plt.show()


print("\nMean Adoption Rate:", df["adoption_rate"].mean())
print("Median Adoption Rate:", df["adoption_rate"].median())
print("Std Dev:", df["adoption_rate"].std())

print("\nQuartiles:\n", df["adoption_rate"].quantile([0.25, 0.5, 0.75]))

print("\nPercentiles:", np.percentile(df['adoption_rate'], [10,25,50,75,90]))



# Industry vs Adoption
industry_adoption = df.groupby('industry')['adoption_rate'].mean().sort_values(ascending=False)
print("\nIndustry Adoption:\n", industry_adoption)

industry_adoption.plot(kind='bar', figsize=(10,5))
plt.title("Industry vs Adoption Rate")
plt.ylabel("Average Adoption Rate")
plt.savefig("images/industry_vs_adoption.png")
plt.show()

# Company Size vs Adoption
size_adoption = df.groupby('company_size')['adoption_rate'].mean()
print("\nCompany Size Adoption:\n", size_adoption)

sns.barplot(x=size_adoption.index, y=size_adoption.values)
plt.title("Company Size vs Adoption Rate")
plt.savefig("images/company_size_vs_adoption.png")
plt.show()

# AI Tool vs Adoption
tool_adoption = df.groupby('ai_tool')['adoption_rate'].mean()
print("\nAI Tool Adoption:\n", tool_adoption)

tool_adoption.plot(kind='bar')
plt.title("AI Tool vs Adoption Rate")
plt.savefig("images/ai_tool_vs_adoption.png")
plt.show()

# Year Trend
year_trend = df.groupby('year')['adoption_rate'].mean()

plt.figure(figsize=(8,5))
plt.plot(year_trend.index, year_trend.values, marker='o')
plt.title("Year vs Adoption Rate Trend")
plt.savefig("images/year_trend.png")
plt.show()


numeric_df = df[['adoption_rate', 'daily_active_users', 'year']]

corr = numeric_df.corr()
print("\nCorrelation Matrix:\n", corr)

plt.figure(figsize=(6,4))
sns.heatmap(corr, annot=True, cmap='coolwarm')
plt.title("Correlation Heatmap")
plt.savefig("images/correlation_heatmap.png")
plt.show()

sns.scatterplot(data=df, x='adoption_rate', y='daily_active_users')
plt.title("Adoption vs Active Users")
plt.savefig("images/scatter_adoption_vs_users.png")
plt.show()


startup = df[df['company_size']=='Startup']['adoption_rate']
sme = df[df['company_size']=='SME']['adoption_rate']
enterprise = df[df['company_size']=='Enterprise']['adoption_rate']

f_stat, p_value = stats.f_oneway(startup, sme, enterprise)

print("\nANOVA Test Results:")
print("F-statistic:", f_stat)
print("P-value:", p_value)

if p_value < 0.05:
    print("Result: Significant difference between company sizes")
else:
    print("Result: No significant difference")


df['adoption_category'] = pd.cut(
    df['adoption_rate'],
    bins=[0,40,70,100],
    labels=['Slow Adopters', 'Early Adopters', 'AI Leaders']
)

print("\nAdoption Category Counts:\n", df['adoption_category'].value_counts())

sns.countplot(data=df, x='adoption_category')
plt.title("Adoption Segmentation")
plt.savefig("images/adoption_category.png")
plt.show()

print("\n--- BUSINESS INSIGHTS ---")

print("\n1. Top Industry:")
print(df.groupby('industry')['adoption_rate'].mean().idxmax())

print("\n2. Most Used AI Tool:")
print(df['ai_tool'].value_counts().idxmax())

print("\n3. Company Size Impact:")
print(df.groupby('company_size')['adoption_rate'].mean())

print("\n4. Age Group Usage:")
print(df.groupby('age_group')['daily_active_users'].mean())

print("\n5. Year Trend:")
print(df.groupby('year')['adoption_rate'].mean())